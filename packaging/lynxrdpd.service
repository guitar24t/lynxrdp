[Unit]
Description=LynxRDP remote desktop daemon (loopback only, reached through SSH)
Documentation=https://github.com/guitar24t/lynxrdp
After=network.target systemd-logind.service
Wants=systemd-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/lynxrdpd --config /etc/lynxrdp/lynxrdp.toml
Restart=on-failure
RestartSec=2
# Sessions are child processes of the daemon but must outlive daemon
# restarts and package upgrades, so only the daemon itself is stopped.
KillMode=process
RuntimeDirectory=lynxrdp
# Traversable so the optional Unix listening socket inside it can be reached
# by the user's sshd. systemd re-applies this mode on every start, so it has
# to agree with lynxrdpd.tmpfiles and postinstall.sh; the daemon keeps
# sessions/ underneath at 0700 itself.
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
LogsDirectory=lynxrdp
LogsDirectoryMode=0700
Environment=RUST_LOG=info
# The daemon must remain root to open PAM sessions and switch to users, and
# the desktop sessions it starts need an unrestricted view of the system, so
# the usual sandboxing directives are intentionally not applied here.

[Install]
WantedBy=multi-user.target
