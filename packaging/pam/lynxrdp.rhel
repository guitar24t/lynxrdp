#%PAM-1.0
# PAM configuration for LynxRDP sessions (RHEL/Fedora and derivatives).
#
# Authentication is not performed here: the user has already authenticated
# through SSH. Only the account and session stacks are used so that
# systemd-logind, pam_env, pam_limits and friends see a normal login.
account    include      system-auth
session    required     pam_loginuid.so
session    optional     pam_keyinit.so force revoke
session    include      system-auth
